# ==========================================
# VARIÁVEIS OBRIGATÓRIAS
# ==========================================

# Conexão com o CRM Hablla
WORKSPACE_ID_HABLLA=workspace_id
API_TOKEN_HABLLA=token_de_api

# ID do Quadro (Board) Padrão no Hablla (IA Manutenção)
# Usado pelo Cronjob e como único quadro acessível para os perfis Gestor e Analista.
# Se não for definido, assume '682251a6c5a42b757a5dbe79'.
BOARD_ID_HABLLA=id_do_quadro

# Segurança de Sessão (Token JWT)
# Chave aleatória usada para assinar os tokens de login. OBRIGATÓRIA: o servidor não inicia sem ela.
# Mínimo de 32 caracteres. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Administrador inicial
# Usado SOMENTE quando o banco não possui nenhum administrador (primeiro deploy): a conta é criada
# com essa senha e o sistema exige a troca dela no primeiro acesso. Senha com no mínimo 12 caracteres.
# Se o banco não tiver administrador e essas variáveis não existirem, o servidor não inicia
# (nenhuma senha padrão é criada). Após o primeiro acesso, ADMIN_PASSWORD pode ser removida.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Recuperação de acesso (uso pontual)
# Com "true", redefine a senha da conta ADMIN_EMAIL para ADMIN_PASSWORD a cada inicialização
# e exige a troca no próximo login. Remova a variável assim que recuperar o acesso.
# ADMIN_RESET_PASSWORD=true

# ==========================================
# VARIÁVEIS OPCIONAIS E DE AMBIENTE
# ==========================================

# Porta que o Node/Express vai rodar (Padrão: 3005)
PORT=3005

# Caminho do Arquivo de Banco de Dados SQLite (no EasyPanel use o volume: /app/data/database.sqlite)
DATABASE_PATH=./database.sqlite

# Pasta dos backups do banco. Padrão: pasta "backups" ao lado do banco (ex.: /app/data/backups),
# ou seja, dentro do mesmo volume persistente.
# BACKUPS_PATH=/app/data/backups

# Tamanho máximo (MB) do arquivo de banco aceito na importação (Padrão: 200)
# MAX_DB_UPLOAD_MB=200

# Origens autorizadas a chamar a API (URL do frontend). Várias origens separadas por vírgula.
# Se não for definida, qualquer origem é aceita.
# CORS_ORIGIN=https://relatorios.dominio.com.br

# Quantidade de proxies reversos à frente do backend (Traefik do EasyPanel = 1).
# Usado para identificar o IP real do cliente no limite de tentativas de login e no histórico de acessos.
# TRUST_PROXY=1

# Envio do resumo de campanha para um webhook (ex.: fluxo do n8n que envia ao Telegram).
# Sem essa variável, o botão de webhook aparece desabilitado na tela de Relatórios.
# WEBHOOK_REPORT_URL=https://n8n.dominio.com.br/webhook/xxxx
# Token opcional enviado no cabeçalho "Authorization: Bearer <token>" para o webhook validar a origem.
# WEBHOOK_REPORT_TOKEN=
